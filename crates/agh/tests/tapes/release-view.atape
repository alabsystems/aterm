:57Z","updated_at":"2026-10-20T08:46:10Z","browser_download_url":"https://github.com/alabsystems/aterm/releases/download/v0.107.0/aterm.dmg"},{"url":"https://api.github.com/repos/alabsystems/aterm/releases/assets/658768555","id":658768555,"node_id":"RA_kwDOTfvfa84nRAKr","name":"aterm.dmg.sha256","label":"","uploader":{"login":"alabsystems","id":306342282,"node_id":"U_kgDOEkJpig","avatar_url":"https://avatars.githubusercontent.com/u/306342282?v=4","gravatar_id":"","url":"https://api.github.com/users/alabsystems","html_url":"https://github.com/alabsystems","followers_url":"https://api.github.com/users/alabsystems/followers","following_url":"https://api.github.com/users/alabsystems/following{/other_user}","gists_url":"https://api.github.com/users/alabsystems/gists{/gist_id}","starred_url":"https://api.github.com/users/alabsystems/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alabsystems/subscriptions","organizations_url":"https://api.github.com/users/alabsystems/orgs","repos_url":"https://api.github.com/users/alabsystems/repos","events_url":"https://api.github.com/users/alabsystems/events{/privacy}","received_events_url":"https://api.github.com/users/alabsystems/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":76,"digest":"sha256:a4f22f07940c1aa7e5567245cfd246a0ec992a420be9a15de1fba440292fbb31","download_count":3,"created_at":"2026-10-20T08:46:18Z","updated_at":"2026-10-20T08:46:18Z","browser_download_url":"https://github.com/alabsystems/aterm/releases/download/v0.107.0/aterm.dmg.sha256"},{"url":"https://api.github.com/repos/alabsystems/aterm/releases/assets/658756203","id":658756203,"node_id":"RA_kwDOTfvfa84nQ9Jr","name":"SHA256SUMS","label":"","uploader":{"login":"alabsystems","id":306342282,"node_id":"U_kgDOEkJpig","avatar_url":"https://avatars.githubusercontent.com/u/306342282?v=4","gravatar_id":"","url":"https://api.github.com/users/alabsystems","html_url":"https://github.com/alabsystems","followers_url":"https://api.github.com/users/alabsystems/followers","following_url":"https://api.github.com/users/alabsystems/following{/other_user}","gists_url":"https://api.github.com/users/alabsystems/gists{/gist_id}","starred_url":"https://api.github.com/users/alabsystems/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alabsystems/subscriptions","organizations_url":"https://api.github.com/users/alabsystems/orgs","repos_url":"https://api.github.com/users/alabsystems/repos","events_url":"https://api.github.com/users/alabsystems/events{/privacy}","received_events_url":"https://api.github.com/users/alabsystems/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":1115182,"digest":"sha256:501e9a57d6ee64fa87de7c56e26ebf45eb415915097acf672c4306852670448a","download_count":1,"created_at":"2026-10-20T08:40:39Z","updated_at":"2026-10-20T08:40:39Z","browser_download_url":"https://github.com/alabsystems/aterm/releases/download/v0.107.0/SHA256SUMS"},{"url":"https://api.github.com/repos/alabsystems/aterm/releases/assets/658756269","id":658756269,"node_id":"RA_kwDOTfvfa84nQ9Kt","name":"SHA256SUMS.sig","label":"","uploader":{"login":"alabsystems","id":306342282,"node_id":"U_kgDOEkJpig","avatar_url":"https://avatars.githubusercontent.com/u/306342282?v=4","gravatar_id":"","url":"https://api.github.com/users/alabsystems","html_url":"https://github.com/alabsystems","followers_url":"https://api.github.com/users/alabsystems/followers","following_url":"https://api.github.com/users/alabsystems/following{/other_user}","gists_url":"https://api.github.com/users/alabsystems/gists{/gist_id}","starred_url":"https://api.github.com/users/alabsystems/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alabsystems/subscriptions","organizations_url":"https://api.github.com/users/alabsystems/orgs","repos_url":"https://api.github.com/users/alabsystems/repos","events_url":"https://api.github.com/users/alabsystems/events{/privacy}","received_events_url":"https://api.github.com/users/alabsystems/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":64,"digest":"sha256:9e90597d3bc328a4d30e453f1163bae98fbd477d70543c8be2305579837ecebc","download_count":1,"created_at":"2026-10-20T08:40:40Z","updated_at":"2026-10-20T08:40:41Z","browser_download_url":"https://github.com/alabsystems/aterm/releases/download/v0.107.0/SHA256SUMS.sig"}],"tarball_url":"https://api.github.com/repos/alabsystems/aterm/tarball/v0.107.0","zipball_url":"https://api.github.com/repos/alabsystems/aterm/zipball/v0.107.0","body":"# aterm v0.107.0\\n\\n2026-10-20 · 2074 changes since v0.106.0\\n\\n## Features\\n\\n- **keeper:** a RELEASE the keeper dropped unread is told again until a SYNC answers behind it\\n- **harness-card:** the rainbow prints vivid on a light theme\\n- **harness:** DECIDED FOR YOU — the choices the harness made in the person's name today (§10.4, slice 3)\\n- **autopilot:** the pause told — a short-turn back-off reads \\"pausing until 18:41\\" (design §10.5 slice 4a)\\n- **autopilot:** the A/B book by word and cause — boxes and questions compared, not idle time (design §10.5 slice 4b)\\n- **autopilot:** the A/B book kept for seven days, one file per process (design §10.5 slice 4c)\\n- **windows:** overlay scrollbar, hairline split seams, hollow pane cursors\\n- **windows:** jump list Recent directories and a taskbar bell badge\\n- **windows:** ship a pinned, signed OpenConsole.exe beside aterm\\n- **windows:** the bundled OpenConsole is the default console host\\n- **aterm-lab:** the crash verb, and LAB\\\\_INSTANCE\\\\_ENV recorded for the lab's own instance\\n- **agy, gui, effects:** agy launch card, composer harness rule, markdown glass & multi-line rainbow wrap\\n- **agent, ctl, gui:** fleet accounts CSV/LAN sync, dashboard, and limit account introspection\\n- **phase, agent, gui:** unified ALab kitty border-and-banner branding, single harness toggle, and visual markdown hierarchy for claude, agy, and muse\\n- **gui:** Autopilot v4 slice 6 — the verdict up front, and the ends counted\\n- **gui:** Settings ▸ Harness's Every session row (Autopilot v4, slice 5)\\n\\n## Fixes\\n\\n- **keeper:** a quit whose BYE was lost owes its returned offers nothing, so it relaunches nothing\\n- **keeper:** a stale RELEASE read late from an older link never ends a newer link's claim\\n- **harness-card:** tippy's cloned\\\\_ref\\\\_to\\\\_slice\\\\_refs in the vividness test; doc wording\\n- **harness:** DECIDED FOR YOU says what was decided, in the run it was decided in (§10.4 review)\\n- **autopilot:** the A/B book splits every session's stretch at midnight; review fixes on 4a-4c\\n- **autopilot:** the A/B book's charge never loops on a midnight that would not move on\\n- **autopilot:** a read title rebuilt by main's TitleReading::refresh keeps the pause as a stamp\\n- **harness:** a limit's end answers a plain question or stop as continue@v1 does\\n- **harness:** a 403 authentication\\\\_failed notice is the lost login, not a refused request\\n- **harness:** an image or attachment full context is told the way back its notice names\\n- **harness:** a notice behind a prompt command right after an error notice is read again\\n- **harness:** an answer typed at a limit's end under any question priority is the limit's try\\n- **harness:** a limit episode closes where the policy reads the limit over, busy read or not\\n- **harness:** a countdown whose notice was written before the agent started goes on by nobody\\n- **harness:** at a limit's reset, another conversation's words get the continue policy's act\\n- **harness:** behind a background shell, another conversation's done report gets no keep going at a limit's reset\\n- **harness:** the vendor's word that it went on, read before the limit's reset, is another day's\\n- **harness:** a conversation's move outlives the record that carried it\\n- **harness:** a relaunch's first decision reads the limit its transcript stands at\\n- **harness:** a bucket's notice older than the relaunched process is the one the fallback left\\n- **phase:** a generic countdown row under a model's bucket is the bucket's\\n- **harness:** a bare `API Error: 403 …` whose login failed is the lost login\\n- **harness:** a turn seen running asks the transcript whether a limit stands\\n- **harness:** `aterm drive watch|supervise` read the tab's Claude Code's record\\n- **harness:** a done report said as a condition is none; `already completed` after the task's subject is one\\n- **harness:** the token first over open work at the done check gets the challenge, not the end\\n- **harness:** a conversation only a peer directed has a task\\n- **harness:** the record reads a wall's retry by its ledger rule, not by the words alone\\n- **harness:** a release typed at a break of background work is a carry-on, as at an idle point\\n- **upgrade:** the upgrade\\\\_ask look reads a token behind long wakes (ATERM-KI-1016-1)\\n- **turn-end:** a loop that follows an older build's ledger knows the job was challenged (ATERM-KI-1016-1)\\n- **upgrade:** Land's answer after the instruction is Land's check to the record (ATERM-KI-1016-1)\\n- **turn-end:** the vendor's own continuation delivers the check a limit cut again (ATERM-KI-1016-1)\\n- **upgrade:** a /loop wake on a build that numbers no turn is a turn of its own (ATERM-KI-1016-1)\\n- **relaunch:** the hand-run sweep's carry-on reads the tab's own Autopilot (ATERM-KI-1016-1)\\n- **upgrade:** a restart's finished read reaches back past a window that settles nothing (ATERM-KI-1016-1)\\n- **turn-end:** a done phrase led by any subordinator is no done report (ATERM-KI-1016-1, KR-DONE-1)\\n- **turn-end:** a subject that names part of the task is no done report (ATERM-KI-1016-1, KR-DONE-2)\\n- **upgrade:** a missed task's notice is a turn of its own with no promptId (ATERM-KI-1016-1, KR-DONE-4)\\n- **upgrade:** one carry-on reads the record once, and the look's memo is pinned (ATERM-KI-1016-1, KR-DONE-3)\\n- **codex:** a relaunched Codex reads Land and its redrawn last reply before its carry-on (ATERM-KI-1016-1, KR-DONE-5)\\n- **turn-end:** the switch's reset types no carry-on into a done task (ATERM-KI-1016-1, KR-DONE-5)\\n- **turn-end:** the switch's own steps neither reopen nor hold a done task (ATERM-KI-1016-1, KR-DONE-5)\\n- **harness:** a loop that follows reads the end of a turn the loop before read running as a turn that ran (ATERM-KI-1016-1, follow-4)\\n- **harness:** a loop that follows takes up an API error's retry ladder (ATERM-KI-1016-1, follow-3)\\n- **harness:** a loop that follows counts a no-reset limit's first rung from the wall (ATERM-KI-1016-1, follow-1)\\n- **harness:** the ledger's cut keeps the rows of states that stand for days, records not counted (ATERM-KI-1016-1, follow-6)\\n- **harness:** a loop that follows reads its own first look as an unread try's first read, however late (ATERM-KI-1016-1, follow-2)\\n- **harness:** the first loop after an older build's reads where that loop stood from its journal (ATERM-KI-1016-1, follow-5)\\n- **harness:** a loop in a tab a cold restore reopened takes up the books of the tab it was reopened from (ATERM-KI-1016-1, follow-7)\\n- **harness:** the ledger's cut reads its files in harness::cli again, as the supervise-fx guard asks (ATERM-KI-1016-1, follow-6, follow-7)\\n- **harness:** a second cold restore reads the earlier books only as far as the tab between still carries them (ATERM-KI-1016-1, follow-7, KRF-3)\\n- **harness:** the ledger's cut keeps only the rows that move a standing state, so it stays bounded while Land or a switch stands (ATERM-KI-1016-1, follow-6, KRF-2)\\n- **harness:** a person's exchange left to them is keyed by its prompt (ATERM-KI-1016-1, person-5)\\n- **harness:** the live upgrade asks nothing at a person's own exchange (ATERM-KI-1016-1, person-8)\\n- **harness:** a wall's retry keeps a person's exchange at the wall open (ATERM-KI-1016-1, person-7)\\n- **harness:** a loop that follows leaves a person's exchange as the loop before it (ATERM-KI-1016-1, person-6)\\n- **harness:** an Esc on the act's answer ends a follower's carry too (ATERM-KI-1016-1, person-6, review KR-P6-ESC)\\n- **harness:** a command the agent does not answer is no turn of its own (ATERM-KI-1016-1, person-5, review KR-P5-CMD)\\n- **harness:** an owed release's settle owns its point (ATERM-KI-1016-1 host-2)\\n- **supervise:** a move repeated at an unchanged point spends a follow-up (ATERM-KI-1016-1 host-3)\\n- **harness:** one unreadable upgrade record keeps its last row, not the whole view (ATERM-KI-1016-1 host-8)\\n- **harness:** the window keeps a tab whose upgrade record cannot be read (ATERM-KI-1016-1 host-8)\\n- **harness:** a carried restart that did not land is said as its record's agent (ATERM-KI-1016-1 host-6)\\n- **harness:** a restored end is decided before its tab's word is cleared (ATERM-KI-1016-1 host-4)\\n- **harness:** the window words the restored agents' row from what the host said (ATERM-KI-1016-1 host-7)\\n- **harness:** a restored step that panicked reads its record before it is said (ATERM-KI-1016-1 host-5)\\n- **harness:** one tab's part of a host pass that panics is that tab's alone (ATERM-KI-1016-1 host-1)\\n- **harness:** the owner is told when the upgrades' records cannot be listed (ATERM-KI-1016-1 host-8)\\n- **harness:** a typed relaunch line is recorded before the ledger line (ATERM-KI-1016-1 host-5)\\n- **harness:** a tab's stage that panicked is asked again on the host's back-off (ATERM-KI-1016-1 host-1, KR-HOST-1)\\n- **harness:** a restored landing that is only its record in flight is said at the fault budget (ATERM-KI-1016-1 host-5, KR-HOST-3)\\n- **harness:** a restored landing's end asks no hook once its attempt is off the 