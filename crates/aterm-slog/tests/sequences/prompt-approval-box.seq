seq v=1 rig=screen program=claude build=2.1.0
# §2.4: prompt (any other kind) opens an approval step box=<kind>; leaving
# the prompt closes it passed; the turn's close counts it.
see busy
half
see prompt bash:not-read-only fixture=claude-2.1.280-box-bash-touch
expect open p1 approval par=t1 box=bash:not-read-only src=screen conf=strong at=500
expect need=approval:bash
expect clause=approval · bash
see busy
expect close p1 approval out=passed
expect need=none
half
see idle
half
half
expect open t1 turn
expect close t1 turn out=done dur_ms=1000 steps=1 appr=1
expect clause=idle
