seq v=1 rig=transcript program=claude build=2.1.0
# Twin of an_adoption_without_a_watermark_replays_nothing (S1, A1).
bind 0
see busy
tx prompt v1
tx tool c1
expect open p1 tool vref=c1
pass 1000
adopt drop-tx after=100
expect tx through=none
tx prompt v2
bind 600
expect mark r1 source state=on skipped=0
expect mark r1 source state=on skipped=600
tx result c1 dated=1099
tx result c1
expect close p1 tool out=ok
