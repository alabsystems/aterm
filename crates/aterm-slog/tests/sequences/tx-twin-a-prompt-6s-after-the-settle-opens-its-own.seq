seq v=1 rig=transcript program=claude build=2.1.0
# Twin of a_prompt_after_the_settle_confirms_the_closed_turn_late, its
# second rig (the negative control, §2.5 row 4).
bind 0
see busy
pass 100
see idle
wait 1000
pass 5000
tx prompt v1
expect open t1 turn src=screen
expect open t2 turn src=transcript
expect wake=7100
wait 1000
expect close t1 turn out=done
expect close t2 turn out=done src=screen
