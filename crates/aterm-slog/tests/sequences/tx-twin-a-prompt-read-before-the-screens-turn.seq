seq v=1 rig=transcript program=claude build=2.1.0
# Twin of a_prompt_read_before_the_screens_turn_names_it, 2 s apart, its first
# rig: since fix E1 a partial prompt opens its own turn, so only a successor
# that adopted an older build's carry line holds an unmapped vendor turn with
# no turn open (tx_v and tx_vp, no tx_vt); the turn the screen opens within
# the window takes vref= at its open.
state partial
bind 0
pass 10000
adopt keep-tx unmapped=vlead
expect tx vref=vlead mapped=none
pass 2000
see busy
expect open t1 turn par=r1 src=screen conf=strong
expect amend t1 turn vref=vlead by=vendor src=transcript conf=strong
tx tool c1
expect open p1 tool par=t1
expect tx dropped=0
