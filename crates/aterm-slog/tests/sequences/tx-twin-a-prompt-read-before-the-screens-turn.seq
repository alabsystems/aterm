seq v=1 rig=transcript program=claude build=2.1.0
# Twin of a_prompt_read_before_the_screens_turn_names_it, 2 s apart: the
# turn the screen opens takes vref= at its open.
state partial
bind 0
pass 10000
tx prompt vlead
expect tx mapped=none
pass 2000
see busy
expect amend t1 turn vref=vlead
tx tool c1
expect open p1 tool par=t1
expect tx dropped=0
