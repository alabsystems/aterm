seq v=1 rig=screen program=claude build=2.1.0
# T10: a delivered task mail, then a `ctl turn` from the harness that names
# no cause: the turn it starts is linked to the mail, heuristically, in the
# fold alone (no record names the link, T10b).
mail task off=3
expect mark - mail dir=in kind=task off=3 by=bridge src=fabric conf=exact
at 1000 ctl
wait 300
see busy
expect open t1 turn ledger=1 by=harness at=1300
expect link=@3
see idle
wait 1000
expect close t1 turn out=done
expect link=@3
