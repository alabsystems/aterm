seq v=1 rig=transcript program=claude build=2.1.0
# Twin of tool_calls_open_under_the_mapped_turn_and_results_close_them
# (§2.4).
bind 0
see busy
tx prompt v1
pass 100
tx tool c1
expect open p1 tool par=t1 cls=shell tool=Bash vref=c1
tx tool c2 tool=Task cls=agent subagent
expect open p2 subagent par=t1
tx tool c1
pass 700
tx result c1 error
expect close p1 tool out=error dur_ms=700 dur=wall
tx result c2
expect close p2 subagent out=ok
