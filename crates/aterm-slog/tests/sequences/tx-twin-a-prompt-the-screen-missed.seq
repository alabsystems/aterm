seq v=1 rig=transcript program=claude build=2.1.0
# Twin of a_prompt_the_screen_missed_opens_the_vendor_turn (§2.5 row 4).
bind 0
pass 400
input human
pass 100
tx prompt v1
expect open t1 turn vref=v1 by=human src=transcript conf=exact
expect wake=none
see busy
pass 1500
tx end
expect close t1 turn out=done
