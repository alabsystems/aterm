seq v=1 rig=transcript program=claude build=2.1.0
# Twin of an_approval_open_when_v2s_prompt_comes_keeps_its_turn (S4).
bind 0
see busy
pass 100
tx prompt v1
pass 100
see prompt bash:not-read-only
pass 100
tx end
pass 700
tx prompt v2
expect tx mapped=t1
pass 100
tx tool c1
expect open p1 approval par=t1 box=bash:not-read-only
expect open p2 tool par=t1 vref=c1
pass 100
see busy
expect close p1 approval out=passed src=screen
pass 100
see idle
wait 1000
expect open t1 turn
expect close t1 turn src=screen
expect close p2 tool out=gone src=screen
tx result c1
expect amend p2 tool out=ok by=vendor conf=exact
