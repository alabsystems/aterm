seq v=1 rig=transcript program=claude build=2.1.0
# Twin of a_turn_end_with_a_screen_step_open_only_amends, its second rig
# (§2.6 row 2).
bind 0
see busy
tx prompt v1
see idle
wait 1000
expect close t1 turn out=done src=screen
tx end
expect amend t1 turn vref=v1
expect amend t1 turn vdur_ms=4200 tok_in=900 tok_out=120
