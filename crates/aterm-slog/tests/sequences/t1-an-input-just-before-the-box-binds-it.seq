seq v=1 rig=screen program=claude build=2.1.0
# T1: an approve admitted with no box open binds the first box to open
# inside STEP_INPUT_LEAD_MS, whether it is accepted before the box shows
# (the lead) or after.
see busy
admit harness act=approve
accept
at 300 see prompt edit
expect open p1 approval par=t1 box=edit at=300
at 400 see busy
expect close p1 approval out=approved by=harness at=400
at 1000 admit harness act=deny
at 1200 see prompt edit
expect open p2 approval par=t1 box=edit at=1200
accept
see busy
expect close p2 approval out=declined by=harness at=1200
