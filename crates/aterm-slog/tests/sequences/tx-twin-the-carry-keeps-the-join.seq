seq v=1 rig=transcript program=claude build=2.1.0
# Twin of the_carry_keeps_the_join_and_the_successor_rebuilds_its_steps (A1).
bind 0
see busy
tx prompt v1
tx tool c1
tx tool c2
adopt keep-tx after=500
expect tx vref=v1 mapped=t1
tx tool c3 off=600 dated=0
tx tool c4 dated=499
tx result c1
expect open p1 tool vref=c1
expect open p2 tool vref=c2
expect close p1 tool out=ok
