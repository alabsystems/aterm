#
# Every dark scheme (foreach-scheme dark: the built-ins and the pack themes) at scale 2, a 12 pt
# window on a Retina display, whose face the light glass draws under (docs/design/PRISM-GLASS.md
# §15.8 amendment 53), with a live band (keys landing every 90 ms) under DECSCNM held from 1420 ms
# to 10100 ms: the reversed page is a light pair no table ships, so a latch that admitted the
# dark scheme would solve it in counted units (about 420 frames) and then draw a glass arm, which
# trail-diff reports as an arm on a dark ground. The run lasts 11.1 s, past that
# solve.

foreach-scheme dark {
  scale 2
  grid 10 60
  style rainbow kitty
  hz 60

  at 0 pty "\e[6;1H$ "
  at 700 key g
  at 702 pty "g"
  at 790 key i
  at 792 pty "i"
  at 880 key t
  at 882 pty "t"
  at 970 key space
  at 972 pty " "
  at 1060 key l
  at 1062 pty "l"
  at 1150 key o
  at 1152 pty "o"
  at 1240 key g
  at 1242 pty "g"
  at 1330 key space
  at 1332 pty " "
  at 1420 pty "\e[?5h"
  at 1420 key -
  at 1422 pty "-"
  at 1510 key -
  at 1512 pty "-"
