#
# Every light scheme (foreach-scheme light: the built-ins and the pack themes) at live off, main's
# paper arm: pause-swoosh on a shell line.

foreach-scheme light {
  grid 16 80
  style rainbow kitty
  hz 60
  live off

  at 0 pty "\e[8;1H$ "
  at 700 key g
  at 702 pty "g"
  at 810 key i
  at 812 pty "i"
  at 920 key t
  at 922 pty "t"
  at 1030 key space
  at 1032 pty " "
  at 1140 key s
  at 1142 pty "s"
  at 1250 key t
  at 1252 pty "t"
  at 1360 key a
  at 1362 pty "a"
  at 1470 key t
  at 1472 pty "t"
  at 1580 key u
  at 1582 pty "u"
  at 1690 key s
  at 1692 pty "s"
  at 4400 key space
  at 4402 pty " "
  at 4510 key -
  at 4512 pty "-"
  at 4620 key -
  at 4622 pty "-"
  at 4730 key s
  at 4732 pty "s"
  at 4840 key h
  at 4842 pty "h"
  at 4950 key o
  at 4952 pty "o"
  at 5060 key r
  at 5062 pty "r"
  at 5170 key t
  at 5172 pty "t"
  run 7680
}
