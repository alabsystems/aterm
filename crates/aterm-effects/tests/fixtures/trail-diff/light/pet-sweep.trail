# Every light scheme (foreach-scheme light: the built-ins and the pack themes) at live off, main's
# paper arm: the pet under pointer sweeps and presses.

foreach-scheme light {
  scale 2
  grid 16 80
  style rainbow kitty
  pet on 7
  hz 60
  live off

  at 0 pty "\e[9;1H$ "
  at 700 key m
  at 702 pty "m"
  at 810 key a
  at 812 pty "a"
