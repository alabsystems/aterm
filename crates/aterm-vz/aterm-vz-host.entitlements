<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright 2026 Andrew Yates
  SPDX-License-Identifier: Apache-2.0

  The helper's one entitlement (docs/DESIGN-vz-guest-2026-10-23.md §5.1): the lab signs
  its content-addressed copy of aterm-vz-host ad hoc with exactly this file, and nothing
  else carries it. The NAT attachment needs no network entitlement in the helper. An XML
  comment holds no double hyphen: codesign's parser (AMFIUnserializeXML) refuses one.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
