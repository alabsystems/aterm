//! GENERATED by aterm-win32-oracle: every declaration of crates/aterm-win32
//! (as `facade`) against the registry windows-sys 0.61.2 (as `upstream`),
//! decided by the compiler for the triple being checked (`aterm-win32-oracle oracle`
//! runs x86_64- and aarch64-pc-windows-msvc). Per declaration:
//!
//! - a type alias: its target, through [`Same`] (a facade struct maps to the
//!   upstream struct of the same path), equals upstream's;
//! - a struct or union: size, alignment, every field's offset and exact type,
//!   the field set (an exhaustive pattern), `Copy`, and `Default` where
//!   upstream has it;
//! - a constant: its exact type and its value (bytes for a C string);
//! - a function: the fn item coerces to the fn-pointer type written from
//!   upstream's text, on each side, and the two types are [`Same`];
//! - the recorded 64-bit layouts and values (tests/recorded.rs in the crate)
//!   equal upstream's, so the recorded table is itself checked here.
//!
//! The import itself (the symbol a reference names and the DLL that defines
//! it) has no const view; `aterm-win32-oracle oracle` compares it from the objects of
//! the `probe-*` builds. Do not edit; regenerate.

#![no_std]
#![allow(
    non_snake_case,
    non_camel_case_types,
    non_upper_case_globals,
    unused,
    ptr_to_integer_transmute_in_consts,
    clippy::all
)]

use core::marker::PhantomData;
use core::mem::{align_of, offset_of, size_of};

/// The upstream type a facade type must be.
pub trait Same {
    type Up;
}

/// Holds only when `A` and `B` are one type.
pub trait Is<T> {}
impl<T> Is<T> for T {}
pub const fn same<A: Is<B>, B>() {}

/// The exact type of a value: `Ty<T>` from `ty_of(&x)` does not coerce.
pub struct Ty<T>(PhantomData<T>);
pub const fn ty_of<T>(_: &T) -> Ty<T> {
    Ty(PhantomData)
}

/// A provenance-free pointer constant's address (`32512u16 as _`).
pub const fn addr<T>(p: *const T) -> usize {
    unsafe { core::mem::transmute::<*const T, usize>(p) }
}

/// Two NUL-terminated byte strings are equal.
pub const fn cstr_eq(a: *const u8, b: *const u8) -> bool {
    let mut i = 0;
    loop {
        let (x, y) = unsafe { (*a.add(i), *b.add(i)) };
        if x != y {
            return false;
        }
        if x == 0 {
            return true;
        }
        i += 1;
    }
}

union Bytes<T: Copy, const N: usize> {
    t: T,
    b: [u8; N],
}

/// The bytes of a padding-free `Copy` value.
pub const fn bytes<T: Copy, const N: usize>(t: T) -> [u8; N] {
    unsafe { Bytes::<T, N> { t }.b }
}

pub const fn bytes_eq<const N: usize>(a: [u8; N], b: [u8; N]) -> bool {
    let mut i = 0;
    while i < N {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

macro_rules! same_prim {
    ($($t:ty),*) => { $(impl Same for $t { type Up = $t; })* };
}
same_prim!(u8, u16, u32, u64, u128, usize, i8, i16, i32, i64, i128, isize, f32, f64, bool, char, (), core::ffi::c_void);
impl<T: Same> Same for *const T {
    type Up = *const T::Up;
}
impl<T: Same> Same for *mut T {
    type Up = *mut T::Up;
}
impl<T: Same, const N: usize> Same for [T; N] {
    type Up = [T::Up; N];
}
impl<T: Same> Same for Option<T> {
    type Up = Option<T::Up>;
}
macro_rules! same_fn {
    ($($a:ident)*) => {
        impl<R: Same, $($a: Same),*> Same for unsafe extern "system" fn($($a),*) -> R {
            type Up = unsafe extern "system" fn($($a::Up),*) -> R::Up;
        }
        impl<R: Same, $($a: Same),*> Same for unsafe extern "C" fn($($a),*) -> R {
            type Up = unsafe extern "C" fn($($a::Up),*) -> R::Up;
        }
    };
}
same_fn!();
